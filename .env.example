# Supabase 연결 설정 템플릿
#
# 이 파일을 복사해 .env.local 로 만들고 값을 채운다. (.env.local은 .gitignore의 *.local에 걸린다)
#
#   cp .env.example .env.local
#
# ⚠️ 반드시 anon / publishable 키만 넣는다. service_role 키는 절대 넣지 말 것.
#    service_role은 RLS를 통째로 우회하고, 프론트엔드 번들에 들어가면
#    브라우저 개발자도구에 그대로 노출된다.
#    → wiki/questions/Q-016-key-storage-actual.md
#
# 값 찾는 곳: Supabase 대시보드 → Project Settings → API
#   Project URL      → VITE_SUPABASE_URL
#   anon / publishable → VITE_SUPABASE_ANON_KEY

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
